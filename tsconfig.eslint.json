{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "noEmit": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "example/**/*.ts", "*.ts"],
    "exclude": ["dist", "node_modules", "coverage"]
}
